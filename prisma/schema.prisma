// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum ColumnType {
    text
    number
}

enum ViewType {
    grid
    kanban
}

enum ViewFilterOperator {
    equals
    contains
    notContains
    isEmpty
    isNotEmpty
    greaterThan
    lessThan
}

enum ViewSortDirection {
    asc
    desc
}

enum ViewFilterConjunction {
    and
    or
}

model Base {
    id        String   @id @default(uuid()) @db.Uuid
    name      String
    lastOpened DateTime?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    tables    Table[]

    @@index([name])
}

model Table {
    id        String   @id @default(uuid()) @db.Uuid
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    baseId    String   @db.Uuid
    base      Base @relation(fields: [baseId], references: [id])
    columns   Column[]
    rows      Row[]
    views     View[]

    @@index([name])
}

model Column {
    id        String   @id @default(uuid()) @db.Uuid
    name      String
    type      ColumnType
    position  Int      
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    tableId   String   @db.Uuid
    table     Table    @relation(fields: [tableId], references: [id])
    cells     Cell[]
    viewFilters           ViewFilter[]
    viewSorts             ViewSort[]
    viewColumnVisibilities ViewColumnVisibility[]

    @@index([tableId])
}

model Row {
    id        String   @id @default(uuid()) @db.Uuid
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    tableId   String   @db.Uuid
    table     Table    @relation(fields: [tableId], references: [id])
    cells     Cell[]

    @@index([tableId])
}

model Cell {
    id        String   @id @default(uuid()) @db.Uuid
    value     String?  // stored as string; parse based on Field.type
    rowId     String   @db.Uuid
    columnId  String   @db.Uuid
    row       Row      @relation(fields: [rowId], references: [id], onDelete: Cascade)
    column    Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)

    @@unique([rowId, columnId])
    @@index([rowId])
    @@index([columnId])
}

model View {
    id          String    @id @default(uuid()) @db.Uuid
    name        String
    type        ViewType  @default(grid)
    tableId     String    @db.Uuid
    table       Table     @relation(fields: [tableId], references: [id])
    isDefault   Boolean   @default(false)
    searchQuery String?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    filters     ViewFilter[]
    sorts       ViewSort[]
    columnVisibilities ViewColumnVisibility[]

    @@index([tableId])
}

model ViewFilter {
    id        String            @id @default(uuid()) @db.Uuid
    viewId    String            @db.Uuid
    view      View              @relation(fields: [viewId], references: [id])
    columnId  String            @db.Uuid
    column    Column            @relation(fields: [columnId], references: [id])
    conjunction ViewFilterConjunction @default(and)
    operator  ViewFilterOperator
    value     String?
    position  Int               @default(0)

    @@index([viewId])
    @@index([columnId])
}

model ViewSort {
    id        String           @id @default(uuid()) @db.Uuid
    viewId    String           @db.Uuid
    view      View             @relation(fields: [viewId], references: [id])
    columnId  String           @db.Uuid
    column    Column           @relation(fields: [columnId], references: [id])
    direction ViewSortDirection
    position  Int              @default(0)

    @@index([viewId])
    @@index([columnId])
}

model ViewColumnVisibility {
    id        String  @id @default(uuid()) @db.Uuid
    viewId    String  @db.Uuid
    view      View    @relation(fields: [viewId], references: [id])
    columnId  String  @db.Uuid
    column    Column  @relation(fields: [columnId], references: [id])
    isVisible Boolean @default(true)

    @@unique([viewId, columnId])
    @@index([viewId])
    @@index([columnId])
}
